<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug builds use Skia so corporate Windows Application Control does not
         need to execute Flutter's impellerc binary during local APK builds. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application>
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
</manifest>
