POSTGRES_PASSWORD=replace-with-strong-local-secret
JWT_KEY=replace-with-at-least-64-random-characters
RABBITMQ_USER=appcoloreando
RABBITMQ_PASSWORD=replace-with-strong-local-secret
MINIO_ROOT_USER=appcoloreando
MINIO_ROOT_PASSWORD=replace-with-strong-local-secret
