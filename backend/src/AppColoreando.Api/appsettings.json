{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=appcoloreando;Username=appcoloreando;Password=change-me-locally"
  },
  "Jwt": {
    "Issuer": "AppColoreando",
    "Audience": "AppColoreando.MobileAdmin",
    "AccessTokenMinutes": 30
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Seed": {
    "Enabled": true
  },
  "RateLimiting": {
    "PermitLimit": 120
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
